{
    "name": "gianko/xpsocial_login",
    "description": "Plugin para conectar wordpress con los api de Xeerpa Social.",
    "version": "5.1.0",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4",
        "phpunit/phpunit": "^9.5",
        "nikic/php-parser": "^5.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Gianko\\Xpsocial_login\\": "./"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gianko\\Xpsocial_login\\Tests\\": "./tests/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=PSR12 --ignore=vendor/* ./",
        "lint-fix": "phpcbf --standard=PSR12 --ignore=vendor/* ./",
        "build": "echo 'Construyendo...' && composer archive --format=zip --file=xpsocial_login",
        "analyse": "phpstan analyse ./",
        "version:get": "php scripts/version.php get",
        "version:set": "php scripts/version.php set",
        "version:patch": "php scripts/version.php patch",
        "version:minor": "php scripts/version.php minor",
        "version:major": "php scripts/version.php major",
        "version:show": "php scripts/version.php show",
        "release:patch": "php scripts/release.php patch",
        "release:minor": "php scripts/release.php minor",
        "release:major": "php scripts/release.php major",
        "release": "php scripts/release.php",
        "test": "echo 'No tests configured yet'",
        "release:info": "php scripts/version.php show"
    }
}
